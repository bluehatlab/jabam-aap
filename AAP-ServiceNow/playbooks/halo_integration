---
- name: Halo to AAP integration test
  hosts: localhost
  gather_facts: false

  tasks:
    - name: Show request received from Halo
      ansible.builtin.debug:
        msg: |
          HaloITSM successfully triggered AAP.
          Ticket: {{ halo_ticket_id | default('TEST') }}
          Requested resource: {{ requested_resource | default('EC2') }}